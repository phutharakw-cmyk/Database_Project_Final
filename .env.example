# Copy this file to .env  (cp .env.example .env)

# Flask
FLASK_SECRET_KEY=change-me-to-any-random-string
FLASK_DEBUG=1
PORT=5000

# MySQL (matches docker-compose.yml)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=movie_app
MYSQL_PASSWORD=movie_pass
MYSQL_DATABASE=movie_ticket_system

# MongoDB (local, no Atlas)
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=movie_ticket_system

# Uploaded posters / avatars are saved here (inside the app server)
UPLOAD_FOLDER=static/uploads
MAX_UPLOAD_MB=5
